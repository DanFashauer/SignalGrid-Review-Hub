{
  "env": {
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(pnpm install)", "Bash(pnpm run *)", "Bash(pnpm --filter * test)",
      "Bash(git status)", "Bash(git log *)", "Bash(git diff *)", "Bash(git show *)",
      "Bash(git branch)", "Bash(git ls-remote *)", "Bash(git fetch *)",
      "Bash(ls *)", "Bash(cat *)"
    ],
    "deny": [
      "Bash(git push --force *)", "Bash(git push -f *)", "Bash(git push --no-verify *)",
      "Bash(git commit --no-verify *)", "Bash(git stash *)", "Bash(git reset --hard *)",
      "Bash(git branch -D *)", "Bash(rm -rf *)", "Bash(sudo *)",
      "Read(**/.env)", "Read(**/.env.*)", "Read(~/.ssh/**)"
    ]
  },
  "statusLine": { "type": "command", "command": "bash -c 'in=$(cat); d=$(printf %s \"$in\" | python3 -I -c \"import json,sys; print(json.load(sys.stdin)[sys.argv[1]][sys.argv[2]])\" workspace project_dir 2>/dev/null); case \"$d\" in /*) ;; *) exit 0 ;; esac; r=$(git -C \"$d\" rev-parse --show-toplevel 2>/dev/null) || exit 0; [ -f \"$r/scripts/mac/statusline.sh\" ] || exit 0; printf %s \"$in\" | bash \"$r/scripts/mac/statusline.sh\"'", "refreshInterval": 30 },
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" } ] }
    ],
    "PreToolUse": [
      { "matcher": "Bash", "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/block-dangerous.sh" } ] }
    ],
    "Stop": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/verify-done.sh" } ] }
    ]
  }
}
