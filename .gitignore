# local environment files (including PC-only Microsoft Graph smoke-test credentials)
.env
.env.local
.env.*.local
.signalgrid.local.env
.microsoft-graph-smoke.local.env

# generated proof evidence
/artifacts/proof/

# generated phase PR reports
/artifacts/phase-pr-report/

# generated Level 10 audit scorecards
/artifacts/level-10/

# Playwright E2E run artifacts (scripts/playwright.config.ts)
/scripts/test-results/
/scripts/playwright-report/

# Self-audit real-run status (one machine's run; never the canonical repo state)
artifacts/self-audit/
artifacts/resource-scan/
# build-loop: the per-run status is ignored, but history.jsonl is TRACKED and read
# by scripts/build-loop.mjs and check-surface-ownership.mjs. Without the
# negation a deleted-and-recreated history would be silently refused by `git add`.
artifacts/build-loop/
!artifacts/build-loop/history.jsonl

# Gradle build output (native/android). The Kotlin core module is compiled and
# unit-tested locally and in CI; neither the class files, the jar, nor Gradle's
# own caches belong in the repository.
native/android/**/build/
native/android/**/.gradle/
.gradle/

# xcodebuild output (native/ios). The android equivalent above was ignored and
# this one was not, so a `run-everything.sh` iOS phase left ~97MB of untracked
# products in the tree. That is not just clutter: run-requests.mjs derives
# provenance.workingTreeClean from `git status --porcelain`, which counts
# untracked files, so the leftovers stamped every LATER sim result as minted
# from a dirty tree.
native/ios/build/

# Obsidian vault config, if anyone opens this repo as a vault.
#
# NOT cosmetic: artifacts/sim-results/*.json derive `provenance.workingTreeClean`
# from `git status --porcelain` being empty — UNTRACKED FILES INCLUDED. An
# unignored .obsidian/ would therefore stamp every subsequent Mac-lane result as
# minted from a dirty tree, which is precisely the defect native/ios/build/ caused
# once already (~97MB untracked, every result mis-stamped). Ignored ahead of the
# first vault rather than after the first bad provenance stamp.
.obsidian/
artifacts/bruno/

# Neural Memory (DR-026) writes a store into any `.git`/`package.json` root it is pointed at; the store lives outside the tree.
.neuralmemory/

# Python bytecode. `scripts/lib/docs-retrieval.py` (DR-041) runs as __main__ and writes none
# today, but any future import of it — or of the two other tracked .py files — mints a
# __pycache__/ beside the source, and an untracked directory in the tree flips
# provenance.workingTreeClean on every LATER sim result. Ignored ahead of the first one.
__pycache__/
*.pyc

# Paths a vendored skill under .claude/skills/ can create INSIDE this repository.
# Same reason as native/ios/build/ and .obsidian/ above: run-requests.mjs derives
# provenance.workingTreeClean from `git status --porcelain`, untracked files
# included, so one leftover directory stamps every LATER sim result as minted from
# a dirty tree. GATED by scripts/check-gitignore-producers.mjs, which re-checks each
# rule against the file:line in the vendored source that produces it.
#
# brainstorming/visual-companion.md:58, brainstorming/scripts/start-server.sh:117,
# subagent-driven-development/scripts/sdd-workspace:36
.superpowers/
# using-git-worktrees/SKILL.md:76 (default) and :72 (the non-hidden alternative it
# will use if it already exists). Project root only, hence the leading slash.
/.worktrees/
/worktrees/
# writing-skills/render-graphs.js:131 renders `dot` blocks into a diagrams/
# directory beside ANY SKILL.md — the wildcard covers every skill, not just the
# one that happened to be checked first.
/.claude/skills/*/diagrams/
# The agent harness's worktree root (stack-reference/ai-cli.md:77). It was ignored
# only by .git/info/exclude, which lives inside .git/, is never committed, and so
# does not exist in a fresh clone or on a CI runner: ignored on exactly one machine.
**/.claude/worktrees/

# The NeMo-RL session-memory checkpoint directory (nemo-rl-session-memory/SKILL.md:27
# says `mkdir -p session/<session_date_time>` in the repo it is run from). Checkpoints
# belong under the session scratchpad; this is the second line of defence, because one
# untracked directory stamps every LATER sim result as minted from a dirty tree.
# Project root only, hence the leading slash.
/session/

# Local knowledge corpus symlinked from iCloud by scripts/mac/sg-brain-link.sh.
# NEVER committed: some of it is confidential and the Review Hub is public-safe.
reference/

# Graphify (owner-directed 2026-09-12): the knowledge-graph build output lives in the tree but is
# never committed — untracked output would flip provenance.workingTreeClean on every sim result.
graphify-out/

# CLI-Anything (owner-directed 2026-09-12): generation writes an agent-harness/ tree, a skills/cli-anything-<x>/
# skill and runtime state files into whatever tree it targets — never this one on purpose, and never committed.
agent-harness/
skills/cli-anything-*/
session.json
trajectory.json
.blend-cli.json

# Crucible (owner-directed 2026-09-12): its compass/adr/build/checkpoint skills write these into docs/ and the
# root; the adversarial lenses are report-only here and none of this is ever committed.
docs/compass.md
docs/decisions/
docs/handoffs/
docs/plans/
build-gate-ledger.md
.lock-compass/
