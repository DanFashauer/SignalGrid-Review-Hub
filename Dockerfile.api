# linux/amd64 + glibc is the one triple `pnpm-workspace.yaml` ships a complete
# native set for. Both halves are load-bearing.
#
# Unpinned, this stage inherited the build host's arch: linux/amd64 on the CI
# runner (which is why it always passed there) and linux/arm64 on an Apple Silicon
# Mac, where `@esbuild/linux-arm64` is stripped and the `pnpm run build` below dies
# with "You installed esbuild for another platform".
#
# Alpine (musl) happens to work for THIS stage — esbuild ships one statically
# linked linux-x64 binary and has no musl variant to strip. That is luck, not a
# property: the moment anything here reaches rollup, lightningcss or oxide, musl
# breaks, since only their -gnu variants survive. Sitting on the same supported
# triple as Dockerfile.web costs a few MB and removes the whole class.
# Guarded by scripts/check-container-native-base.mjs.
FROM --platform=linux/amd64 docker.io/library/node:22-bookworm-slim AS builder

WORKDIR /app

RUN corepack enable pnpm

# tsconfig.base.json — the SAME omission as Dockerfile.web, and this image shipped
# with it because esbuild disagrees with vite about how bad it is. vite treats an
# unresolvable `extends` as fatal; esbuild emits a warning and carries on with its
# own defaults. So this build printed
#
#     ▲ [WARNING] Cannot find base config file "../../tsconfig.base.json"
#     16 warnings
#
# on every run, went green, and produced a bundle compiled WITHOUT the repo's
# declared compilerOptions — `target: es2022` most consequentially, since esbuild
# uses it to decide what to downlevel. The emitted `dist/index.mjs` was therefore
# not the artifact this repo's config describes.
#
# Found by reading the log of the web-build step added alongside it, not by any
# gate: nothing fails a build over warnings, and nobody reads 16 of them.
COPY pnpm-workspace.yaml pnpm-lock.yaml package.json tsconfig.base.json ./
# The root `preinstall` runs `node scripts/enforce-pnpm.cjs`, and `scripts` is a
# workspace package — copy its manifest + the guard so the install resolves the
# workspace and the preinstall hook both succeed (its src isn't needed to build
# the API).
# AND the lifecycle-hook entrypoints, from the launch lane — a separate
# requirement from tsconfig.base.json above, and both are load-bearing.
# The root lifecycle hooks run from THIS directory, and `scripts` is a workspace
# package — copy its manifest plus every hook entrypoint so the install resolves the
# workspace and the hooks both succeed (their src isn't needed to build the API):
#   preinstall -> scripts/enforce-pnpm.cjs
#   prepare    -> scripts/install-git-hooks.mjs
#
# KEEP THIS LIST IN STEP WITH THE ROOT `scripts` BLOCK. `install-git-hooks.mjs` is
# written to be non-fatal in every branch — it exits 0 on CI, on a missing `.git`,
# on a missing hook file — and none of that care survives the file being ABSENT,
# because `node <missing>` fails before the first line runs. A script's own defensive
# handling cannot cover the case where the script is not there. `pnpm install` then
# fails and the whole image build dies, which is exactly what happened the day the
# `prepare` hook was added without this line.
# `scripts/check-docker-lifecycle-copy.mjs` derives the required list from
# package.json and fails locally rather than in a Docker build nobody runs locally.
COPY scripts/package.json scripts/enforce-pnpm.cjs scripts/install-git-hooks.mjs ./scripts/
COPY lib/ ./lib/
COPY artifacts/api-server/ ./artifacts/api-server/

RUN pnpm install --frozen-lockfile

WORKDIR /app/artifacts/api-server
RUN pnpm run build

FROM docker.io/library/node:22-alpine AS runtime

WORKDIR /app

RUN corepack enable pnpm

COPY --from=builder /app/pnpm-workspace.yaml /app/pnpm-lock.yaml /app/package.json ./
COPY --from=builder /app/scripts/package.json /app/scripts/enforce-pnpm.cjs /app/scripts/install-git-hooks.mjs ./scripts/
COPY --from=builder /app/lib/ ./lib/
COPY --from=builder /app/artifacts/api-server/package.json ./artifacts/api-server/
COPY --from=builder /app/artifacts/api-server/dist/ ./artifacts/api-server/dist/

# CI=true so pnpm never prompts to purge a modules dir (non-interactive build).
RUN CI=true pnpm install --frozen-lockfile --prod

# REMOVE npm FROM THE SHIPPING IMAGE. It is not used by anything here: the
# install above runs through corepack/pnpm, and the entrypoint is plain `node`.
# It is not merely unused — it is the sole source of a CRITICAL finding. The
# daily image-vulnerability gate went red on 2026-08-22 and stayed red for two
# days on GHSA-23hp-3jrh-7fpw: `tar` 7.5.11, fixed in 7.5.19, carried at
# /usr/local/lib/node_modules/npm/node_modules/tar inside the base image.
#
# The tracking issue said "bump the affected base layer or dependency", and
# that advice could not be followed: scanning docker.io/library/node:22-alpine
# directly shows the CURRENT published tag still ships 7.5.11, so there was
# nothing to bump to. The choices were to suppress a real critical or to delete
# code the image does not run. Deleting it is the honest one — the vulnerable
# bytes are gone rather than filtered out of a report, and the attack surface
# shrinks by a package manager that had no business being in a runtime image.
#
# If npm is ever genuinely needed at runtime, this line must be removed
# deliberately and the advisory re-checked — not worked around.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/bin/npm /usr/local/bin/npx

# Non-root, per the platform operability pass: the server needs no write
# access outside /tmp, and a root process in a compromised container is the
# difference between a bad day and a very bad day. The deploy-stack CI job
# asserts id -u != 0 on the running container.
RUN chown -R node:node /app
USER node
WORKDIR /app/artifacts/api-server

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["node", "--enable-source-maps", "./dist/index.mjs"]
