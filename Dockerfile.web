FROM node:22-alpine AS builder

WORKDIR /app

RUN corepack enable pnpm

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
# Same requirement as Dockerfile.api: the root `preinstall` and `prepare` hooks run
# from here, so their entrypoints must exist in the image or `pnpm install` dies.
# This image is NOT built by the prod-compose smoke, so the omission was latent —
# `docker build -f Dockerfile.web .` has been failing on the preinstall hook for
# anyone who tried it, with nothing in CI to say so. Found by deriving the required
# list from package.json rather than by building it.
COPY scripts/package.json scripts/enforce-pnpm.cjs scripts/install-git-hooks.mjs ./scripts/
COPY lib/ ./lib/
COPY artifacts/signalgrid-web/ ./artifacts/signalgrid-web/
COPY artifacts/signalgrid-app/ ./artifacts/signalgrid-app/

RUN pnpm install --frozen-lockfile

WORKDIR /app/artifacts/signalgrid-web
RUN BASE_PATH=/ pnpm run build

WORKDIR /app/artifacts/signalgrid-app
RUN BASE_PATH=/app/ pnpm run build

FROM nginx:alpine AS runtime

# Vite emits to dist/public (see each app's vite.config.ts outDir).
COPY --from=builder /app/artifacts/signalgrid-web/dist/public/ /usr/share/nginx/html/
COPY --from=builder /app/artifacts/signalgrid-app/dist/public/ /usr/share/nginx/html/app/
# Serve on :3000 with SPA fallback to match docker-compose + nginx upstream.
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
