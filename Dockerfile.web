# glibc, and pinned to amd64 — both are load-bearing. `pnpm-workspace.yaml` keeps
# exactly one triple per native family: **linux-x64-gnu**. Alpine is musl, and
# `@rollup/rollup-linux-x64-musl`, `lightningcss-linux-x64-musl` and
# `@tailwindcss/oxide-linux-x64-musl` are all stripped — so the vite build below
# could never succeed in an alpine builder, on any host. Unpinned, an Apple
# Silicon Mac would also target linux/arm64, where both the gnu and musl arm64
# variants are stripped too.
#
# Nothing caught it because docker-compose.prod.yml (what CI's deploy-stack job
# builds) contains only `db` and `api`; this image is referenced solely by the dev
# docker-compose.yml, which no gate ever built. Now guarded by
# scripts/check-container-native-base.mjs.
#
# The runtime stage below stays native-arch: nginx serves static files and needs
# none of this.
FROM --platform=linux/amd64 node:22-bookworm-slim AS builder

WORKDIR /app

RUN corepack enable pnpm

COPY pnpm-workspace.yaml pnpm-lock.yaml package.json ./
COPY lib/ ./lib/
COPY artifacts/signalgrid-web/ ./artifacts/signalgrid-web/
COPY artifacts/signalgrid-app/ ./artifacts/signalgrid-app/

RUN pnpm install --frozen-lockfile

WORKDIR /app/artifacts/signalgrid-web
RUN BASE_PATH=/ pnpm run build

WORKDIR /app/artifacts/signalgrid-app
RUN BASE_PATH=/app/ pnpm run build

FROM nginx:alpine AS runtime

# Vite emits to dist/public (see each app's vite.config.ts outDir).
COPY --from=builder /app/artifacts/signalgrid-web/dist/public/ /usr/share/nginx/html/
COPY --from=builder /app/artifacts/signalgrid-app/dist/public/ /usr/share/nginx/html/app/
# Serve on :3000 with SPA fallback to match docker-compose + nginx upstream.
COPY docker/nginx-web.conf /etc/nginx/conf.d/default.conf

EXPOSE 3000

CMD ["nginx", "-g", "daemon off;"]
