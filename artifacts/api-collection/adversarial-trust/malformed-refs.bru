meta {
  name: Non-string refs are a validation refusal
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/decisions/evaluate
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": 42,
    "deviceRef": ["a"],
    "workflowKey": {}
  }
}

assert {
  res.status: eq 400
}

tests {
  test("type-confused refs never reach the engine", function () {
    expect(res.body.error).to.equal("validation");
  });
}

docs {
  Shape violations die at the parser with a 400 - the engine only ever sees well-typed questions.
}
