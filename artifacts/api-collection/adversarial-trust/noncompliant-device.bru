meta {
  name: Noncompliant device restricts
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/decisions/evaluate
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": "nurse.noncompliant",
    "deviceRef": "ipad-ward-02",
    "workflowKey": "clinical-session"
  }
}

assert {
  res.status: eq 200
}

tests {
  test("a noncompliant device is restricted with the code named", function () {
    expect(res.body.decision.outcome).to.equal("restrict");
    expect(res.body.decision.reasonCodes).to.include("DEVICE_NONCOMPLIANT");
  });
}

docs {
  The clean negative control for the folder: a KNOWN bad state, tightened, with its reason on the wire.
}
