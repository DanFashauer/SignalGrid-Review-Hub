meta {
  name: Unknown device is not found - never graded
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/v1/decisions/evaluate
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": "nurse.compliant",
    "deviceRef": "device-never-seeded",
    "workflowKey": "clinical-session"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("a device the tenant has never seen cannot earn any verdict", function () {
    expect(res.body.error).to.equal("not_found");
    expect(res.body.decision).to.equal(undefined);
  });
}

docs {
  The engine refuses to grade what it cannot identify. An unknown deviceRef is a 404, not a low-trust allow - a verdict about nothing would still read as a verdict.
}
