meta {
  name: Unsupported workflow is not found - never defaulted
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/decisions/evaluate
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": "nurse.compliant",
    "deviceRef": "ipad-ward-01",
    "workflowKey": "workflow-not-defined"
  }
}

assert {
  res.status: eq 404
}

tests {
  test("an undefined workflow is refused, never graded under a default policy", function () {
    expect(res.body.error).to.equal("not_found");
  });
}

docs {
  A workflow the tenant never defined must not fall through to some implicit policy - the refusal IS the policy.
}
