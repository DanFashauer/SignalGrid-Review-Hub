meta {
  name: Evaluate - compliant nurse
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/decisions/evaluate
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": "nurse.compliant",
    "deviceRef": "ipad-ward-01",
    "workflowKey": "clinical-session"
  }
}

docs {
  The happy path: healthy identity + managed device -> allow. Fixture actors from the demo seed.
}

script:post-response {
  if (res.body && res.body.decision && res.body.decision.decisionId) {
    bru.setVar("decisionId", res.body.decision.decisionId);
  }
}
