meta {
  name: Start session
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/v1/sessions/start
  body: json
  auth: inherit
}

body:json {
  {
    "identityRef": "nurse.compliant",
    "deviceRef": "ipad-ward-01",
    "workflowKey": "clinical-session"
  }
}

script:post-response {
  if (res.body && res.body.session && res.body.session.id) {
    bru.setVar("sessionId", res.body.session.id);
  }
}

docs {
  Captures the new session id into {{sessionId}} so the get/refresh/end
  requests below run in sequence with no hand-editing.
}
