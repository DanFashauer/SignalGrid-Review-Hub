  },
  "dependencies": {
    "@workspace/api-zod": "workspace:*",
    "@workspace/orchestration": "workspace:*",
    "@workspace/app-workflows": "workspace:*",
    "@workspace/flows": "workspace:*",
    "@workspace/recommendations": "workspace:*",
    "@workspace/signalgrid-core": "workspace:*",
    "@workspace/persistence": "workspace:*",
    "@workspace/enterprise-auth": "workspace:*",
    "pg": "^8.13.1",
    "@workspace/signalgrid-simulator": "workspace:*",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "@workspace/room-sim": "workspace:*",
    "@workspace/signal-radar": "workspace:*",
    "@workspace/self-audit": "workspace:*",
    "@workspace/reliability": "workspace:*",
