# SignalGrid — prod tier (public-safe example; contains NO secrets).
# Copy to your deploy secret store and fill real values where noted.
SIGNALGRID_TIER=prod
# Live vendor integrations are OFF by default. dev/alpha can NEVER go live.
# beta/prod may go live only when this is "true" AND real creds are provided.
SIGNALGRID_LIVE_INTEGRATIONS=false
LOG_LEVEL=warn
PORT=8080
# NODE_ENV: development for dev/alpha, production for beta/prod.
NODE_ENV=production
# Optional real-integration config (only read when SIGNALGRID_LIVE_INTEGRATIONS=true):
#   REDIS_URL=...            (custody/nonce/webhook stores; in-memory when unset)
#   FLEETDM_BASE_URL=...  FLEETDM_TOKEN=...
#   INTEGRATION_SIGNING_SECRET=...   WEBHOOK_DELIVERY_REQUIRED=...

# The profile fence: unset resolves to review-demo, which serves demo
# credentials and the unauthenticated simulator. Never unset off a reviewer box.
SIGNALGRID_PRODUCT_PROFILE=shared-device-gateway

# REQUIRED with the gateway profile: enterprise OIDC. The gateway accepts only
# verified IdP credentials — with these unset, enterprise auth stays disabled
# and EVERY request is 401: the deployment has no usable API. All five must be
# set (the two maps are hard-required by the config loader; blank = unset).
#   OIDC_ISSUER=https://login.example.com/<tenant>/v2.0
#   OIDC_AUDIENCE=<the API's app/client id at the IdP>
#   OIDC_JWKS_URI=<the IdP discovery document's jwks_uri>
#   OIDC_TENANT_MAP={"<idp-tenant-id>":"<internal-tenant-id>"}
#   OIDC_ROLE_MAP={"<idp-role-or-group>":"operator"}
# Optional: OIDC_TENANT_CLAIM (tid) / OIDC_ROLE_CLAIM (roles) /
#   OIDC_SUBJECT_CLAIM (sub) / OIDC_CLOCK_TOLERANCE_SEC (60)
