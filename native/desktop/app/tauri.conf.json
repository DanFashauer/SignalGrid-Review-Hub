{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SignalGrid Assist",
  "version": "0.1.0",
  "identifier": "com.signalgrid.assist.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "SignalGrid Assist — reference host shell",
        "width": 720,
        "height": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
