EnterpriseShell.xcodeproj/
# Local build output
.build-dd/
DerivedData/
# SwiftPM build output for Package.swift (the macOS run of the decision port)
.build/
.swiftpm/
Package.resolved
# run-ios.sh screenshots
*.png
# …but asset-catalog images (app icon, etc.) are real tracked assets, not screenshots.
!EnterpriseShell/Resources/Assets.xcassets/**/*.png
# Developer-local signing (team id, identity, bundle id). Signing.xcconfig (the
# simulator defaults) and Signing.local.xcconfig.example are tracked; the real
# local file never is — Signing.xcconfig pulls it in with `#include?`, so its
# absence is not an error and simulator builds need nothing.
Signing.local.xcconfig
