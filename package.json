    "proof:session-store-pg": "pnpm --filter @workspace/scripts run proof:session-store-pg",
    "proof:observability": "pnpm --filter @workspace/scripts run proof:observability",
    "proof:enterprise-auth": "pnpm --filter @workspace/scripts run proof:enterprise-auth",
    "proof:graph-connector": "pnpm --filter @workspace/scripts run proof:graph-connector",
    "proof:carrier-reachability": "pnpm --filter @workspace/scripts run proof:carrier-reachability",
    "proof:event-contract": "pnpm --filter @workspace/scripts run proof:event-contract",
    "proof:location-services": "pnpm --filter @workspace/scripts run proof:location-services",
    "proof:vuln-scan": "pnpm --filter @workspace/scripts run proof:vuln-scan",
    "proof:posture-composition": "pnpm --filter @workspace/scripts run proof:posture-composition",
    "proof:incident-playbook": "pnpm --filter @workspace/scripts run proof:incident-playbook",
    "proof:network-nac": "pnpm --filter @workspace/scripts run proof:network-nac",
    "proof:edr-threat": "pnpm --filter @workspace/scripts run proof:edr-threat",
