{
  "name": "signalgrid-review-hub",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.28.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "proof:intune-entra-posture": "pnpm --filter @workspace/scripts run proof:intune-entra-posture",
    "proof:signalgrid-core": "pnpm --filter @workspace/scripts run proof:signalgrid-core",
    "proof:api-contract": "pnpm --filter @workspace/scripts run proof:api-contract",
    "proof:webauthn-verify": "pnpm --filter @workspace/scripts run proof:webauthn-verify",
    "proof:audit-ledger": "pnpm --filter @workspace/scripts run proof:audit-ledger",
    "proof:audit-ledger-pg": "pnpm --filter @workspace/scripts run proof:audit-ledger-pg",
    "test:api": "pnpm --filter @workspace/api-server run test:api",
    "bench:decision-latency": "pnpm --filter @workspace/scripts run bench:decision-latency",
    "sbom": "pnpm --filter @workspace/scripts run sbom",
    "proof:signalgrid-simulator": "pnpm --filter @workspace/scripts run proof:signalgrid-simulator",
    "sim:signalgrid": "pnpm run proof:signalgrid-simulator",
    "dev:simulator": "node scripts/dev-simulator.cjs",
    "proof:signalgrid-grid": "pnpm --filter @workspace/scripts run proof:signalgrid-grid",
    "proof:microsoft-graph-sandbox": "pnpm --filter @workspace/scripts run proof:microsoft-graph-sandbox",
    "proof:connector-emulator": "pnpm --filter @workspace/scripts run proof:connector-emulator",
    "smoke:connector-emulator": "pnpm run proof:connector-emulator",
    "phase:gate": "pnpm --filter @workspace/scripts run phase:gate",
    "phase:summary-check": "pnpm --filter @workspace/scripts run phase:summary-check",
    "phase:pr-report": "pnpm --filter @workspace/scripts run phase:pr-report",
    "autopilot:backlog-check": "pnpm --filter @workspace/scripts run autopilot:backlog-check",
    "level10:audit": "pnpm --filter @workspace/scripts run level10:audit",
    "proof:orchestration": "pnpm --filter @workspace/scripts run proof:orchestration",
    "dispatch": "node scripts/dev-dispatch.mjs",
    "sync": "node scripts/sync.mjs",
    "proof:app-workflows": "pnpm --filter @workspace/scripts run proof:app-workflows",
    "proof:app-workflow-templates": "pnpm --filter @workspace/scripts run proof:app-workflow-templates",
    "proof:flows": "pnpm --filter @workspace/scripts run proof:flows",
    "proof:recommendations": "pnpm --filter @workspace/scripts run proof:recommendations",
    "proof:room-sim": "pnpm --filter @workspace/scripts run proof:room-sim",
    "build:room-console": "pnpm --filter @workspace/scripts run build:room-console",
    "proof:signal-radar": "pnpm --filter @workspace/scripts run proof:signal-radar",
    "proof:control-plane": "pnpm --filter @workspace/scripts run proof:control-plane",
    "proof:edge-sync": "pnpm --filter @workspace/scripts run proof:edge-sync",
    "proof:telemetry-up": "pnpm --filter @workspace/scripts run proof:telemetry-up",
    "build:postman": "node scripts/build-postman.mjs",
    "check:postman": "node scripts/build-postman.mjs --check",
    "safety:check": "node scripts/safety-check.mjs",
    "docs:sanity": "node scripts/docs-sanity.mjs",
    "review:invariants": "node scripts/review-invariants.mjs",
    "preflight": "node scripts/preflight.mjs",
    "proof:signal-discovery": "pnpm --filter @workspace/scripts run proof:signal-discovery",
    "proof:ddm-connector": "pnpm --filter @workspace/scripts run proof:ddm-connector",
    "proof:decision-store-pg": "pnpm --filter @workspace/scripts run proof:decision-store-pg",
