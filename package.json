{
  "name": "signalgrid-review-hub",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "node scripts/enforce-pnpm.cjs",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "proof:intune-entra-posture": "pnpm --filter @workspace/scripts run proof:intune-entra-posture",
    "proof:signalgrid-simulator": "pnpm --filter @workspace/scripts run proof:signalgrid-simulator",
    "sim:signalgrid": "pnpm run proof:signalgrid-simulator",
    "dev:simulator": "node scripts/dev-simulator.cjs",
    "proof:signalgrid-grid": "pnpm --filter @workspace/scripts run proof:signalgrid-grid",
    "proof:microsoft-graph-sandbox": "pnpm --filter @workspace/scripts run proof:microsoft-graph-sandbox",
    "proof:connector-emulator": "pnpm --filter @workspace/scripts run proof:connector-emulator",
    "smoke:connector-emulator": "pnpm run proof:connector-emulator",
    "phase:gate": "pnpm --filter @workspace/scripts run phase:gate",
    "phase:summary-check": "pnpm --filter @workspace/scripts run phase:summary-check",
    "phase:pr-report": "pnpm --filter @workspace/scripts run phase:pr-report",
    "autopilot:backlog-check": "pnpm --filter @workspace/scripts run autopilot:backlog-check",
    "level10:audit": "pnpm --filter @workspace/scripts run level10:audit",
    "autopilot:evidence": "node scripts/signalgrid-autopilot-evidence.cjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
